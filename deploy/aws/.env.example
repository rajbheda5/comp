# Compose-level settings for deploy/aws/docker-compose.yml.
# `scripts/init-env.sh` copies this to .env and fills the generated values.

# ---- Hostnames (each needs a DNS A record pointing at the Lightsail static IP)
APP_DOMAIN=app.example.com
PORTAL_DOMAIN=portal.example.com
API_DOMAIN=api.example.com
DB_DOMAIN=db.example.com
# Parent domain shared by the three web hosts, with a leading dot. Lets the
# session cookie set by the API be read by the app and the portal.
COOKIE_DOMAIN=.example.com
# Let's Encrypt account / expiry notices.
ACME_EMAIL=ops@example.com

# ---- Container images (built by .github/workflows/aws-deploy.yml)
# ghcr.io/<github-owner-lowercase>
IMAGE_PREFIX=ghcr.io/your-github-user
IMAGE_TAG=latest

# ---- Postgres (runs on the instance). Hex only, so it is URL-safe.
POSTGRES_USER=comp
POSTGRES_DB=comp
POSTGRES_PASSWORD=__GENERATE__

# ---- Local Upstash-compatible Redis endpoint token
REDIS_HTTP_TOKEN=__GENERATE__

# ---- Trigger.dev Cloud (free tier): two projects, prod secret keys (tr_prod_...)
# App project ("comp-app") and API project ("comp-api").
TRIGGER_APP_SECRET_KEY=
TRIGGER_API_SECRET_KEY=

# ---- Nightly pg_dump backups (scripts/backup-db.sh)
BACKUP_BUCKET=
BACKUP_AWS_REGION=us-east-2
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
