# CI-only Caddyfile: same sites as ../Caddyfile, but certificates come from a
# throwaway root CA generated by smoke-test.sh instead of Let's Encrypt, so the
# whole TLS chain (HTTPS and Postgres) can be verified without public DNS.

{
	local_certs
	skip_install_trust
	pki {
		ca local {
			root {
				format pem_file
				cert /ci/root.crt
				key /ci/root.key
			}
		}
	}
}

{$APP_DOMAIN} {
	reverse_proxy app:3000
}

{$PORTAL_DOMAIN} {
	reverse_proxy portal:3000
}

{$API_DOMAIN} {
	reverse_proxy api:3333
}

{$DB_DOMAIN} {
	respond 404
}
