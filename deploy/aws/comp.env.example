# Runtime secrets shared by the app, portal and api containers.
# URLs, DATABASE_URL, Redis and Trigger keys are set per service in
# docker-compose.yml from .env, so they are not repeated here.
#
# Trigger.dev Cloud runs the background tasks, so paste this same file (plus
# the extra lines listed in deploy/aws/README.md) into BOTH Trigger.dev
# projects' Production environment variables.
#
# `scripts/init-env.sh` fills every __GENERATE__ value with a random secret.

# ---- Auth / internal secrets (required) --------------------------------------
# The API signs sessions with SECRET_KEY; keep the three auth secrets identical.
SECRET_KEY=__GENERATE__
AUTH_SECRET=__GENERATE__
BETTER_AUTH_SECRET=__GENERATE__
# Encrypts stored integration credentials. Never change it after first use.
ENCRYPTION_KEY=__GENERATE__
REVALIDATION_SECRET=__GENERATE__
UNSUBSCRIBE_SECRET=__GENERATE__
INTERNAL_API_TOKEN=__GENERATE__
SERVICE_TOKEN_TRIGGER=__GENERATE__
SERVICE_TOKEN_PORTAL=__GENERATE__

# ---- Email: Resend free tier (3,000/month, 100/day) — required ---------------
RESEND_API_KEY=
RESEND_DOMAIN=mail.example.com
RESEND_FROM_SYSTEM=Comp <system@mail.example.com>
RESEND_FROM_DEFAULT=Comp <noreply@mail.example.com>
RESEND_FROM_MARKETING=Comp <noreply@mail.example.com>
RESEND_FROM_TRUST_PORTAL=Comp <trust@mail.example.com>

# ---- AI — pay per use. None are needed to boot; features fail without them. --
# Onboarding (policy/risk/vendor generation) and suggestion reranking go
# through Vercel AI Gateway (model google/gemini-3-flash). Key from
# vercel.com → AI Gateway → API keys.
AI_GATEWAY_API_KEY=
# Chat, questionnaires, embeddings and most other AI features (app + api).
OPENAI_API_KEY=
# Used by several API features (e.g. browser automation, assistants).
ANTHROPIC_API_KEY=
# Optional; a few app features.
# GROQ_API_KEY=

# ---- S3 file storage (created by scripts/provision-aws.sh) -------------------
APP_AWS_REGION=us-east-2
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_BUCKET_NAME=
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=
APP_AWS_KNOWLEDGE_BASE_BUCKET=
APP_AWS_ORG_ASSETS_BUCKET=

# ---- Optional ----------------------------------------------------------------
# Security-questionnaire knowledge base (Upstash Vector free tier).
# UPSTASH_VECTOR_REST_URL=
# UPSTASH_VECTOR_REST_TOKEN=
# Web research for vendor/risk enrichment.
# FIRECRAWL_API_KEY=
# Social sign-in (email magic links work without these).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_TENANT_ID=
# Browser automations (paid Browserbase account).
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
